import argparse
import math
import sys

AXES = ("acidity", "bitterness", "body", "sweetness", "aroma")

KEY_ALIASES = {
    "acidity": "acidity", "酸味": "acidity",
    "bitterness": "bitterness", "苦味": "bitterness",
    "body": "body", "コク": "body",
    "sweetness": "sweetness", "甘み": "sweetness",
    "aroma": "aroma", "香り": "aroma",
}

# 名前, 焙煎度, 酸味, 苦味, コク, 甘み, 香り（1〜5, 作者による主観評価）
BEANS = [
    ("エチオピア・イルガチェフェ", "light", 5, 1, 2, 4, 5),
    ("エチオピア・シダモ", "light", 4, 2, 3, 5, 5),
    ("ケニア", "light", 5, 2, 4, 3, 4),
    ("タンザニア", "medium", 4, 2, 3, 3, 3),
    ("コスタリカ", "medium", 4, 2, 3, 4, 3),
    ("グアテマラ", "medium", 3, 3, 3, 4, 4),
    ("コロンビア", "medium", 3, 3, 4, 4, 3),
    ("イエメン・モカ", "medium", 3, 3, 4, 4, 5),
    ("ブラジル", "medium", 2, 3, 3, 4, 2),
    ("インドネシア・マンデリン", "dark", 1, 4, 5, 3, 3),
    ("ベトナム・ロブスタ", "dark", 1, 5, 5, 1, 1),
]


def parse_line(line):
    """'酸味=4 苦味=2' のような1行を {軸: 値} の辞書にする"""
    pref = {}
    for token in line.split():
        if "=" not in token:
            raise ValueError(f"key=value の形式ではありません: {token}")
        key, value = token.split("=", 1)
        if key not in KEY_ALIASES:
            raise ValueError(f"不明な項目です: {key}")
        if not value.isdigit() or not 1 <= int(value) <= 5:
            raise ValueError(f"値は1〜5の整数で指定してください: {token}")
        pref[KEY_ALIASES[key]] = int(value)
    return pref


def rank(pref, beans):
    """好みとのユークリッド距離が近い順に (豆名, 一致度%) を返す"""
    max_dist = 4 * math.sqrt(len(pref))
    scored = []
    for bean in beans:
        sq = 0
        for axis, value in pref.items():
            sq += (bean[2 + AXES.index(axis)] - value) ** 2
        scored.append((math.sqrt(sq), bean[0]))
    scored.sort(key=lambda x: x[0])
    return [(name, round(100 * (1 - d / max_dist))) for d, name in scored]


def print_ranking(pref, beans, number):
    for name, score in rank(pref, beans)[:number]:
        print(f"{name}\t{score}")


def main():
    parser = argparse.ArgumentParser(
        prog="beanmatch",
        description="コーヒーの好みから、合う豆を出力する。"
                    "好みを引数で渡すと1件だけ、"
                    "引数がなければ標準入力を1行1件として処理する")
    parser.add_argument("prefs", nargs="*", metavar="項目=値",
                        help="1件分の好み（例: 酸味=4 香り=5）")
    parser.add_argument("-n", "--number", type=int, default=1,
                        help="好み1件につき出力する豆の数（既定: 1）")
    parser.add_argument("-r", "--roast",
                        choices=["light", "medium", "dark"],
                        help="焙煎度で候補を絞る")
    parser.add_argument("-l", "--list", action="store_true",
                        help="豆のデータを一覧表示して終了する")
    args = parser.parse_args()

    if args.number < 1:
        print("beanmatch: -n には1以上を指定してください", file=sys.stderr)
        return 1

    beans = [b for b in BEANS if args.roast is None or b[1] == args.roast]

    if args.list:
        for bean in beans:
            print("\t".join(str(x) for x in bean))
        return 0

    if args.prefs:
        try:
            pref = parse_line(" ".join(args.prefs))
        except ValueError as e:
            print(f"beanmatch: {e}", file=sys.stderr)
            return 1
        print_ranking(pref, beans, args.number)
        return 0

    status = 0
    for lineno, line in enumerate(sys.stdin, 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        try:
            pref = parse_line(line)
        except ValueError as e:
            print(f"beanmatch: {lineno}行目: {e}", file=sys.stderr)
            status = 1
            continue
        print_ranking(pref, beans, args.number)
    return status


if __name__ == "__main__":
    sys.exit(main())
